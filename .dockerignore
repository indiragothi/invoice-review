# Keep the build context small and keep secrets, data and caches out of the image.
.git
.gitignore
.claude
**/.env
**/.env.*
!**/.env.example
**/__pycache__
**/*.pyc
**/.venv
**/.ruff_cache
**/.pytest_cache
**/node_modules
frontend/dist
backend/data
backend/data_backup_*
backend/static
backend/tests
backend/scripts
**/*.db
**/*.sqlite*
playground
evaluation
samples
docs
private
