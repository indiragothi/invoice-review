# Which LLM provider the pipeline uses: gemini | nvidia
LLM_PROVIDER=gemini

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# NVIDIA hosted models (free credits): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Second, independent vision reading: always | on_doubt | never
SECOND_READING=on_doubt

# Optional shared-password gate (leave unset for local development)
# APP_ACCESS_PASSWORD=replace-with-demo-password
# APP_SESSION_SECRET=replace-with-long-random-secret
# ALLOWED_ORIGIN=http://localhost:5173
