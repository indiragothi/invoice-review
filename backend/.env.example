# Which LLM provider the pipeline uses: gemini | nvidia
LLM_PROVIDER=gemini

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# NVIDIA hosted models (free credits): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Pipeline
CONFIDENCE_THRESHOLD=0.80
MAX_UPLOAD_MB=5
DATABASE_URL=sqlite:///./data/invoice_review.db
